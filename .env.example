# Hosted provider - free tier at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Model ids differ per key. List yours:
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_MODEL=gemini-3.5-flash-lite

LLM_PROVIDER=google                 # google | ollama

# Local dev and eval runs - free, repeatable, no quota
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional - the app runs unlimited without these
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_FILE_MB=10
MAX_PAGES=20
