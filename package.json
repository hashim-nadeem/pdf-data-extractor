{
  "name": "doc-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a PDF invoice, CV or contract and get validated structured JSON where every field carries the source text it came from.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fixtures": "tsx evals/generate.ts",
    "eval": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env evals/run.ts",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^10.5.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "gifenc": "^1.0.3",
    "pdfkit": "^0.20.2",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
